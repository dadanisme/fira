rules_version = '2';

// Multi-tenant layout (SPEC.md "Access rules"): everything lives under workspaces/{wid}.
// Access is "a member doc keyed by my uid exists"; roles are enforced only by the API,
// because clients can never write workspaces, members or invites.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Lowercased email of the caller; also their `invites/{id}` document id.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function verified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    // One exists() per request; repeated paths are deduplicated, so batches stay well
    // under the 20-call limit.
    function isMember(wid) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
    }

    function isContent(coll) {
      return coll in ['projects', 'labels', 'cards', 'pages'];
    }

    // The content subcollections of SPEC.md (cards: comments, activity, attachments;
    // pages: versions, presence, threads, attachments). A fixed list, not `**`: otherwise a
    // member could create e.g. cards/x/members/y or pages/x/invites/z, which the
    // collection-group queries below would surface to other users as fake memberships/invites.
    function isContentSub(sub) {
      return sub in ['comments', 'activity', 'attachments', 'versions', 'presence', 'threads'];
    }

    // Content writes stop once the API has flagged the workspace for deletion (and when the
    // workspace doc is gone: get() of a missing doc is null, so this errors, which denies).
    // One get() per request, deduplicated across a batch like isMember().
    function notDeleting(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)).data.get('deleting', false) != true;
    }

    // An attachment record must point at its own object:
    // workspaces/{wid}/{cards|pages}/{id}/{attachmentId}/{name}. Otherwise a member could plant a
    // record naming another workspace's file, which the API (Admin SDK) would sign or delete.
    // Compared segment by segment (no regex, so ids need no escaping).
    function ownAttachmentPath(wid, coll, id, aid, data) {
      return (coll == 'cards' || coll == 'pages')
        && data.storagePath is string
        && pathSegmentsOk(data.storagePath.split('/'), wid, coll, id, aid);
    }

    function pathSegmentsOk(p, wid, coll, id, aid) {
      return p.size() >= 6
        && p[0] == 'workspaces' && p[1] == wid && p[2] == coll && p[3] == id && p[4] == aid
        && p[5].size() > 0;
    }

    match /workspaces/{wid} {
      // Server-only writes (Admin SDK) for the workspace, its members and invites.
      allow read: if isMember(wid);

      match /members/{uid} {
        allow read: if isMember(wid);
      }

      match /invites/{email} {
        allow read: if isMember(wid);
      }

      match /{coll}/{id} {
        allow read: if isContent(coll) && isMember(wid);
        allow write: if isContent(coll) && isMember(wid) && notDeleting(wid);
      }

      match /{coll}/{id}/{sub}/{subId} {
        allow read: if isContent(coll) && isContentSub(sub) && isMember(wid);
        allow delete: if isContent(coll) && isContentSub(sub) && isMember(wid) && notDeleting(wid);
        allow create, update: if isContent(coll) && isContentSub(sub) && isMember(wid) && notDeleting(wid)
          && (sub != 'attachments' || ownAttachmentPath(wid, coll, id, subId, request.resource.data));
      }
    }

    // Collection-group queries: "my workspaces" and "my invites". Queries must filter on
    // uid / email, or they are denied.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/invites/{email} {
      allow read: if verified() && resource.data.email == myEmail();
    }

    // slugs/*, tokens/*, inviteSends/*, inviteQuotas/*: no rules, so no client access. No client writes to workspaces,
    // members or invites anywhere.
  }
}
