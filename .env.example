# Client (exposed to the SPA via Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# 1 = use the local Firebase emulators (set by `npm run dev:emu`; leave unset otherwise)
VITE_USE_EMULATORS=

# Server (Vercel functions in api/)
# Service account key JSON, on one line
FIREBASE_SERVICE_ACCOUNT=
# Invite emails (Resend); unset key = invites are saved but not emailed
RESEND_API_KEY=
INVITE_FROM=
# Origin for links in emails (default https://fira-six.vercel.app)
APP_URL=
