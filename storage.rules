rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // A workspace member: `workspaces/{wid}/members/{uid}` exists in Firestore.
    // Cross-service rules: Storage needs permission to read Firestore (granted on deploy).
    function isMember(wid) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/workspaces/$(wid)/members/$(request.auth.uid));
    }

    // Card attachments: workspaces/{wid}/cards/{cardId}/{attachmentId}/{name}
    // Page files: workspaces/{wid}/pages/{pageId}/{attachmentId}/{name}. Pages embed them
    // by download-token URL (?alt=media&token=...), which Storage serves without these rules.
    // Max 10 MB per file (LIMITS.fileBytes in shared/workspaces.ts).
    match /workspaces/{wid}/{area}/{rest=**} {
      allow read, delete: if area in ['cards', 'pages'] && isMember(wid);
      allow create, update: if area in ['cards', 'pages'] && isMember(wid)
        && request.resource.size <= 10 * 1024 * 1024;
    }
  }
}
