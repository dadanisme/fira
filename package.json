{
  "name": "fira",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "firebase emulators:exec --only firestore,storage,auth --project demo-fira 'tsx scripts/dev-emu-api.ts & VITE_USE_EMULATORS=1 vite'",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:api": "firebase emulators:exec --only firestore,storage,auth --project demo-fira 'tsx scripts/api-smoke.ts'",
    "test:rules": "firebase emulators:exec --only firestore,storage,auth --project demo-fira 'tsx scripts/rules-test.ts'",
    "test:docs": "firebase emulators:exec --only firestore --project demo-fira 'TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/page-save-check.ts'",
    "test:migrate": "firebase emulators:exec --only firestore,storage,auth --project demo-fira 'tsx scripts/migrate-check.ts'",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-workspaces.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "busboy": "^1.6.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/node": "^24.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
